---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

interface Project {
  title: string;
  description: string;
  tags: string[];
  imageSrc: string;
  aspectRatio: string;
  link?: string;
}

interface Experience {
  role: string;
  company: string;
  period: string;
  tags: string[];
  bullets: string[];
}

interface Education {
  degree: string;
  institution: string;
  period: string;
  description?: string;
}

interface Certification {
  title: string;
  issuer: string;
  date: string;
  link?: string;
}

interface Design {
  title: string;
  category: string;
  aspectRatio: string;
  imageSrc: string;
}

const projects: Project[] = [
  {
    title: "Universe of Books",
    description: "A book recommendation chatbot.",
    tags: ["React", "Next.js", "TypeScript", "Tailwind CSS", "Supabase"],
    imageSrc: "/projects/universe-of-books.png",
    aspectRatio: "aspect-video",
    link: "https://universe-of-books.pages.dev/",
  },
  {
    title: "Whisper Generator",
    description:
      "An intuitive text generator website inspired by the former Whisper app.",
    tags: ["Svelte", "TypeScript", "Tailwind CSS"],
    imageSrc: "/projects/whisper-generator.png",
    aspectRatio: "aspect-video",
    link: "https://whisper-generator.pages.dev/",
  },
];

const experiences: Experience[] = [
  {
    role: "Intern",
    company: "PROPILVEN S.A.",
    period: "January 2025 - June 2025",
    tags: [
      "HTML",
      "CSS",
      "JavaScript",
      "PHP",
      "Twig",
      "SQL",
      "Camtasia Studio",
    ],
    bullets: [
      "Development and implementation of a required module in the company's document management system, as well as improvements to the appearance and functionality in different sections using HTML, CSS, JavaScript, PHP and SQL.",
      "Automation of customer satisfaction survey management through the integration and customization of open-source software, adapting it to the company's specific needs using HTML, CSS, PHP, Twig and SQL.",
      "Editing of video tutorials, incorporating subtitles and improving the audio using Camtasia Studio.",
    ],
  },
  {
    role: "Data Analyst",
    company: "ALCALDÍA DE MARACAIBO",
    period: "March 2026",
    tags: ["HTML", "CSS", "JavaScript", "Google Sheets", "App Script"],
    bullets: [
      "Development of web forms using HTML, CSS and Javascript integrated into Google Sheets using Apps Script.",
    ],
  },
];

const educationList: Education[] = [
  {
    degree: "Software Engineering",
    institution: "Universidad Privada Dr. Rafael Belloso Chacín",
    period: "2020 - 2025",
    description:
      "Bachelor's Thesis: Development of a functional mobile application focused on improving the efficiency and comfort of older adults through an accessible interface, using React Native, JavaScript and Firebase.",
  },
];

const certifications: Certification[] = [
  {
    title: "Community Manager",
    issuer: "Centro Educativo Logros",
    date: "2019",
  },
];

const designs: Design[] = [
  {
    title: "Love Dive",
    category: "Digital Manipulation",
    aspectRatio: "aspect-video",
    imageSrc: "/designs/love-dive.png",
  },
  {
    title: "Forever Valentine",
    category: "Header",
    aspectRatio: "aspect-video",
    imageSrc: "/designs/forever-valentine.png",
  },
  {
    title: "Sweet Bubble Gum",
    category: "Header",
    aspectRatio: "aspect-video",
    imageSrc: "/designs/sweet-bubble-gum.png",
  },
];
---

<Layout>
  <header
    class="fixed top-0 left-0 right-0 z-50 bg-[#faf8f5]/80 backdrop-blur-md border-b border-rose-100/40 px-6 py-4 transition-transform duration-300"
  >
    <div
      class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4"
    >
      <a
        href=""
        class="group flex items-center gap-2 font-mono text-sm tracking-widest text-slate-700 hover:text-rose-500 transition-colors"
      >
        <span
          class="text-rose-400 group-hover:rotate-12 transition-transform inline-block"
          >🌸</span
        > VALEZKA.DEV
      </a>
      <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
        <a
          href="#home"
          class="hover:text-rose-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-rose-400 hover:after:w-full after:transition-all"
          >home</a
        >
        <a
          href="#resume"
          class="hover:text-rose-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-rose-400 hover:after:w-full after:transition-all"
          >resume</a
        >
        <a
          href="#projects"
          class="hover:text-rose-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-rose-400 hover:after:w-full after:transition-all"
          >projects</a
        >
        <a
          href="#portfolio"
          class="hover:text-rose-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-rose-400 hover:after:w-full after:transition-all"
          >designs</a
        >
        <a
          href="#contact"
          class="hover:text-rose-500 transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-rose-400 hover:after:w-full after:transition-all"
          >contact</a
        >
      </nav>
    </div>
  </header>

  <main
    class="max-w-4xl mx-auto px-6 py-16 space-y-14 sm:px-6 pt-24 pb-14 sm:py-16"
  >
    <section id="home" class="pt-4 scroll-mt-20 space-y-6">
      <div class="flex items-start gap-4">
        <div
          class="text-5xl p-2 bg-rose-50 rounded-2xl border border-rose-100 shadow-xs animate-bounce [animation-duration:3s]"
        >
          🌸
        </div>
        <div class="space-y-1">
          <h1
            class="text-4xl font-bold tracking-tight text-slate-800 relative inline-block"
          >
            Valezka López
            <span
              class="absolute bottom-1 left-0 w-full h-[6px] bg-rose-200/50 -z-10 rounded-xs"
            ></span>
          </h1>
          <p class="text-xl font-mono text-slate-500 font-light">
            Software engineer & artist
          </p>
        </div>
      </div>

      <p class="text-base text-slate-600 leading-relaxed max-w-2xl pt-2">
        Hello! I'm <span class="font-medium text-slate-800">Valezka</span>, a
        full-stack software engineer and hobbyist digital artist. I am
        passionate about web development, photography and video/photo editing.
      </p>

      <div class="flex items-center gap-3 pt-2">
        <a
          href="https://github.com/valezks2"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-white hover:bg-rose-50/40 border border-slate-200 hover:border-rose-200 rounded-xl text-xs font-mono text-slate-600 hover:text-rose-500 transition-all shadow-2xs"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.48,0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.061.069-.061 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z"
            ></path></svg
          >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/valezks2"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-white hover:bg-rose-50/40 border border-slate-200 hover:border-rose-200 rounded-xl text-xs font-mono text-slate-600 hover:text-rose-500 transition-all shadow-2xs"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path></svg
          >
          LinkedIn
        </a>
        <a
          href="https://orcid.org/0009-0001-5773-8896"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-white hover:bg-rose-50/40 border border-slate-200 hover:border-rose-200 rounded-xl text-xs font-mono text-slate-600 hover:text-rose-500 transition-all shadow-2xs"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.531 0 .962.431.962.962s-.431.962-.962.962-.962-.431-.962-.962.431-.962.962-.962zm5.513 11.127h-1.25V7.87h1.25v7.635zm3.844-3.834c0 2.21-1.393 3.834-3.56 3.834h-2.138V7.87h2.38c2.062 0 3.318 1.42 3.318 3.805zm-1.187.006c0-1.743-.807-2.67-2.15-2.67h-1.094v5.333h1.056c1.387 0 2.188-1.018 2.188-2.663zM7.369 7.87h.625v7.635h-.625V7.87z"
            ></path>
          </svg>
          ORCID
        </a>
      </div>

      <div
        class="bg-white/60 border border-slate-100 p-6 rounded-2xl space-y-5 shadow-xs backdrop-blur-xs transition-all duration-300 hover:border-rose-200"
      >
        <h3
          class="font-mono text-xs uppercase tracking-widest text-rose-400 font-bold"
        >
          Skills & Stack
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="space-y-3">
            <span
              class="text-xs font-mono text-slate-400 block border-b border-slate-100 pb-1"
              >Core Skills:</span
            >
            <ul
              class="space-y-1.5 text-xs font-medium text-slate-600 font-mono"
            >
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Adaptability
              </li>
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Attention to Detail
              </li>
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Responsibility
              </li>
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Problem-Solving
              </li>
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Critical Thinking
              </li>
              <li class="flex items-center gap-2">
                <span class="text-rose-400 text-[10px]">✦</span> Time Management
              </li>
            </ul>
          </div>

          <div class="space-y-3">
            <span
              class="text-xs font-mono text-slate-400 block border-b border-slate-100 pb-1"
              >Tools & Technologies:</span
            >
            <div class="flex flex-wrap gap-1.5">
              {
                [
                  "React",
                  "Next.js",
                  "TypeScript",
                  "Tailwind CSS",
                  "Photoshop",
                  "HTML/CSS",
                  "JavaScript",
                  "Svelte",
                  "Astro",
                  "PHP",
                  "Python",
                  "React Native",
                  "SQL",
                  "Supabase",
                  "Canva",
                  "Capcut",
                ].map((tool) => (
                  <span class="px-2 py-0.5 bg-slate-50 text-slate-600 text-[11px] font-medium rounded-md border border-slate-200/60">
                    {tool}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="space-y-3">
            <span
              class="text-xs font-mono text-slate-400 block border-b border-slate-100 pb-1"
              >Languages:</span
            >
            <div class="space-y-2">
              <div
                class="flex items-center justify-between text-xs font-medium text-slate-600 px-2.5 py-1.5 bg-rose-50/40 rounded-lg border border-rose-100/30"
              >
                <span>Spanish</span>
                <span class="text-[10px] font-mono text-slate-400">Native</span>
              </div>
              <div
                class="flex items-center justify-between text-xs font-medium text-slate-600 px-2.5 py-1.5 bg-slate-50/50 rounded-lg border border-slate-100"
              >
                <span>English</span>
                <span class="text-[10px] font-mono text-rose-400 font-bold"
                  >C1 / Fluent</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resume" class="scroll-mt-32 sm:scroll-mt-20 space-y-10">
      <div class="space-y-1">
        <h2
          class="text-2xl font-bold text-slate-800 tracking-tight relative inline-block"
        >
          Resume
          <span
            class="absolute bottom-1 left-0 w-full h-[4px] bg-rose-200/50 -z-10 rounded-xs"
          ></span>
        </h2>
        <!-- <p class="text-sm font-mono text-slate-400">
          My professional background, studies and courses.
        </p> -->
      </div>

      <div class="space-y-10">
        <div class="space-y-5">
          <h3
            class="text-lg font-bold tracking-tight text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2"
          >
            Work Experience
          </h3>

          <div class="space-y-12">
            {
              experiences.map((exp) => (
                <div class="relative pl-6 border-l-2 border-rose-200 space-y-4">
                  <div class="absolute left-[-6px] top-1.5 w-[10px] h-[10px] bg-rose-400 rounded-full border-2 border-white shadow-xs" />

                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                      <h4 class="text-base font-bold text-slate-700 tracking-tight">
                        {exp.role}
                      </h4>
                      <p class="text-sm font-mono text-rose-500 font-semibold">
                        {exp.company}
                      </p>
                    </div>
                    <div>
                      <span class="px-3 py-1 bg-slate-100 text-slate-500 font-mono text-xs rounded-lg border border-slate-200/40 shadow-3xs">
                        {exp.period}
                      </span>
                    </div>
                  </div>

                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {exp.tags.map((tag) => (
                      <span class="px-2.5 py-0.5 bg-rose-50/60 text-rose-600/90 border border-rose-100/40 rounded-full text-xs font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <ul class="space-y-2.5 text-sm text-slate-600 leading-relaxed pt-2">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start gap-3">
                        <span class="text-rose-400 mt-1.5 shrink-0 text-xs font-mono">
                          —
                        </span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="space-y-5">
          <h3
            class="text-lg font-bold tracking-tight text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2"
          >
            Education
          </h3>

          <div class="space-y-12">
            {
              educationList.map((edu) => (
                <div class="relative pl-6 border-l-2 border-rose-200 space-y-4">
                  <div class="absolute left-[-6px] top-1.5 w-[10px] h-[10px] bg-rose-400 rounded-full border-2 border-white shadow-xs" />

                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                      <h4 class="text-lg font-bold text-slate-800 tracking-tight">
                        {edu.degree}
                      </h4>
                      <p class="text-sm font-mono text-rose-500 font-semibold">
                        {edu.institution}
                      </p>
                    </div>
                    <div>
                      <span class="px-3 py-1 bg-slate-100 text-slate-500 font-mono text-xs rounded-lg border border-slate-200/40 shadow-3xs">
                        {edu.period}
                      </span>
                    </div>
                  </div>

                  {edu.description && (
                    <div class="flex items-start gap-3 text-sm text-slate-600 leading-relaxed pt-2">
                      <span class="text-rose-400 mt-1.5 shrink-0 text-xs font-mono">
                        —
                      </span>
                      <span>{edu.description}</span>
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <div class="space-y-5">
          <h3
            class="text-lg font-bold tracking-tight text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2"
          >
            Certifications & Courses
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              certifications.map((cert) => (
                <div class="bg-white/60 border border-slate-100 p-4 rounded-2xl shadow-xs backdrop-blur-xs transition-all duration-300 hover:border-rose-200 flex flex-col justify-between gap-3">
                  <div class="space-y-1">
                    <h4 class="text-sm font-bold text-slate-800 tracking-tight leading-snug">
                      {cert.title}
                    </h4>
                    <p class="text-xs font-mono text-slate-400 font-medium">
                      {cert.issuer}
                    </p>
                  </div>

                  <div class="flex justify-between items-center pt-1 border-t border-slate-100">
                    <span class="text-[10px] font-mono text-slate-400">
                      Issued: {cert.date}
                    </span>
                    {cert.link && (
                      <a
                        href={cert.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[10px] font-mono font-semibold text-rose-500 hover:text-rose-600 transition-colors flex items-center gap-1"
                      >
                        Verify <span>&rarr;</span>
                      </a>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="scroll-mt-32 sm:scroll-mt-20 space-y-8">
      <div class="space-y-1">
        <h2
          class="text-2xl font-bold text-slate-800 tracking-tight relative inline-block"
        >
          Projects
          <span
            class="absolute bottom-1 left-0 w-full h-[4px] bg-rose-200/50 -z-10 rounded-xs"
          ></span>
        </h2>
        <!-- <p class="text-sm font-mono text-slate-400">My personal projects</p> -->
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          projects.map((project) => (
            <a
              href={project.link || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="group block bg-white border border-slate-200/60 p-3 rounded-2xl hover:border-rose-200 hover:shadow-xs transition-all space-y-3 cursor-pointer"
            >
              <div
                class={`w-full ${project.aspectRatio} rounded-xl bg-slate-100 relative overflow-hidden flex items-center justify-center border border-slate-100 shadow-inner`}
              >
                {project.imageSrc && (
                  <img
                    src={project.imageSrc}
                    alt={project.title}
                    class="absolute inset-0 w-full h-full object-cover z-10 group-hover:scale-102 transition-all duration-300"
                  />
                )}
              </div>

              <div class="px-1 space-y-2">
                <div class="flex justify-between items-center">
                  <h4 class="text-sm font-bold text-slate-800 group-hover:text-rose-500 transition-colors">
                    {project.title}
                  </h4>
                </div>

                <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-1 pt-1">
                  {project.tags.map((tag) => (
                    <span class="px-2 py-0.5 bg-slate-50 text-slate-500 text-[10px] font-mono rounded-md border border-slate-200/40">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="portfolio" class="scroll-mt-32 sm:scroll-mt-20 space-y-8">
      <div class="space-y-1">
        <h2
          class="text-2xl font-bold text-slate-800 tracking-tight relative inline-block"
        >
          Designs
          <span
            class="absolute bottom-1 left-0 w-full h-[4px] bg-rose-200/50 -z-10 rounded-xs"
          ></span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          designs.map((design) => (
            <div class="group bg-white border border-slate-200/60 p-3 rounded-2xl hover:border-rose-200 hover:shadow-xs transition-all space-y-3">
              <div
                class={`w-full ${design.aspectRatio} rounded-xl bg-slate-100 relative overflow-hidden flex items-center justify-center border border-slate-100 shadow-inner`}
              >
                {design.imageSrc && (
                  <img
                    src={design.imageSrc}
                    alt={design.title}
                    class="absolute inset-0 w-full h-full object-cover z-10 group-hover:scale-102 transition-all duration-300"
                  />
                )}
              </div>

              <div class="px-1 flex justify-between items-center">
                <div>
                  <h4 class="text-sm font-bold text-slate-800 group-hover:text-rose-500 transition-colors">
                    {design.title}
                  </h4>
                  <p class="text-xs font-mono text-slate-400">
                    {design.category}
                  </p>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-50 text-slate-400 rounded-md border border-slate-200/50">
                  PSD
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="contact" class="scroll-mt-32 sm:scroll-mt-20 space-y-8">
      <div class="space-y-1">
        <h2
          class="text-2xl font-bold text-slate-800 tracking-tight relative inline-block"
        >
          Contact
          <span
