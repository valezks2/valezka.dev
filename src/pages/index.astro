<script>
  const themeToggleBtn = document.getElementById("theme-toggle");

  themeToggleBtn?.addEventListener("click", () => {
    if (document.documentElement.classList.contains("dark")) {
      document.documentElement.classList.remove("dark");
      localStorage.setItem("theme", "light");
    } else {
      document.documentElement.classList.add("dark");
      localStorage.setItem("theme", "dark");
    }
  });

  const lightboxItems = document.querySelectorAll("[data-lightbox]");
  const modal = document.getElementById("lightbox-modal");
  const modalImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const modalCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");

  lightboxItems.forEach((item) => {
    item.addEventListener("click", () => {
      const imgSrc = item.getAttribute("data-lightbox");
      const imgTitle = item.getAttribute("data-title");

      if (modal && modalImg && modalCaption && imgSrc) {
        modalImg.src = imgSrc;
        modalImg.alt = imgTitle || "";
        modalCaption.textContent = imgTitle || "";

        modal.classList.remove("opacity-0", "pointer-events-none");
        setTimeout(() => {
          modalImg.classList.remove("scale-95");
        }, 50);

        document.body.style.overflow = "hidden";
      }
    });
  });

  const closeModal = () => {
    if (modal && modalImg) {
      modal.classList.add("opacity-0", "pointer-events-none");
      modalImg.classList.add("scale-95");
      document.body.style.overflow = "";
    }
  };

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
    }
  });
</script>
